{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit*)",
      "Bash(npm run lint*)",
      "Bash(npx eslint *)",
      "Bash(npm run build)",
      "Bash(CI=true npm test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "deny": [
      "Read(./.envrc)"
    ]
  }
}
